 }
 
+void Qwen35Backend::apply_target_yarn_override() {
+    // Disabled (factor<=1.0) leaves w_.rope_ext_factor at its 0.0f default --
+    // byte-identical plain RoPE, same as before this flag existed.
+    if (cfg_.target_yarn_factor <= 1.0f) {
+        if (w_.native_context_length > 0 &&
+            cfg_.device.max_ctx > w_.native_context_length) {
+            std::fprintf(stderr,
+                "[target] WARNING: --max-ctx %d exceeds this model's native "
+                "trained context %d and --yarn-factor was not set -- "
+                "positions beyond %d extrapolate with no correction and "
+                "will degrade; pass --yarn-factor to extend context "
+                "correctly\n",
+                cfg_.device.max_ctx, w_.native_context_length,
+                w_.native_context_length);
+        }
+        return;
+    }
+
+    const int orig_ctx = cfg_.target_yarn_orig_ctx > 0
+        ? cfg_.target_yarn_orig_ctx
+        : (w_.native_context_length > 0 ? w_.native_context_length : 262144);
+    w_.rope_freq_scale  = 1.0f / cfg_.target_yarn_factor;
+    w_.rope_ext_factor  = 1.0f;
+    w_.rope_attn_factor = 1.0f;
+    w_.rope_beta_fast   = cfg_.target_yarn_beta_fast;
+    w_.rope_beta_slow   = cfg_.target_yarn_beta_slow;
+    w_.rope_n_ctx_orig  = orig_ctx;
+    const int extended_max = (int)(orig_ctx * (double)cfg_.target_yarn_factor);
+    std::printf("[target] YaRN enabled: factor=%.2f orig_ctx=%d "
+                "beta_fast=%.1f beta_slow=%.1f -> extended max %d\n",
+                cfg_.target_yarn_factor, orig_ctx,
+                cfg_.target_yarn_beta_fast, cfg_.target_yarn_beta_slow,
+                extended_max);
+    if (cfg_.device.max_ctx > extended_max) {
+        std::fprintf(stderr,
+            "[target] WARNING: --max-ctx %d exceeds the YaRN-extended range "
+            "%d*%.2f=%d -- positions beyond that extrapolate with no "
+            "correction; lower --max-ctx or raise --yarn-factor\n",
+            cfg_.device.max_ctx, orig_ctx, cfg_.target_yarn_factor,
+            extended_max);
+    }
+}
+
 bool Qwen35Backend::load_target_model(ggml_backend_t backend, TargetWeights & out) {
     return load_target_gguf(cfg_.target_path, backend, out);
 }
